{% extends 'base.html' %}{% load static %}{% block content %}<link rel="stylesheet" href="{% static 'css/employee_notices_policy_cards.css' %}?v=16.58">{% if portal_notices %}<section class="vone-notice-modern" id="vone-notice-section" aria-label="Company announcements"><div class="vone-notice-modern-head"><span class="vone-notice-modern-label"><span aria-hidden="true">📣</span> Company notice</span><a href="{% url 'portal:notifications' %}">View all <span aria-hidden="true">→</span></a></div><div class="vone-notice-modern-list">{% for notice in portal_notices %}<article class="vone-notice-modern-item" data-notice-id="{{ notice.pk }}-{{ notice.updated_at|date:'U' }}"><div class="vone-notice-modern-content"><div class="vone-notice-modern-title">{% if notice.priority == 'urgent' %}<span class="vone-notice-modern-priority">Urgent</span>{% elif notice.priority == 'important' %}<span class="vone-notice-modern-priority important">Important</span>{% endif %}<strong>{{ notice.title }}</strong></div>{% if notice.event_at or notice.event_location %}<div class="vone-notice-modern-meta">{% if notice.event_at %}<span>📅 {{ notice.event_at|date:'d M Y, h:i A' }}</span>{% endif %}{% if notice.event_location %}<span>📍 {{ notice.event_location }}</span>{% endif %}</div>{% endif %}{% if notice.summary %}<p>{{ notice.summary|striptags|truncatechars:180 }}</p>{% elif notice.body %}<p>{{ notice.body|striptags|truncatechars:180 }}</p>{% endif %}</div><form method="post" action="{% url 'portal:notification_read' notice.pk %}" class="vone-notice-read-form">{% csrf_token %}<input type="hidden" name="next" value="home"><button type="submit" class="vone-notice-modern-close" aria-label="Dismiss {{ notice.title }}" title="Dismiss announcement">×</button></form></article>{% endfor %}</div></section>{% endif %}<div class="dashboard-intro"><div><span class="eyebrow">YOUR DIGITAL WORKPLACE</span><h1>Good to see you <span class="wave">✳</span></h1><p>Everything you need for your workday, all in one place.</p></div><div class="date-pill" id="today-date"></div></div><section class="hero"><div class="hero-copy"><span class="hero-tag">✦ INTRODUCING VISHAKHA ONE</span><h2>One place for everything<br><span>that moves work forward.</span></h2><p>Access your everyday tools, explore company updates and get support — seamlessly.</p><div class="hero-actions"><button class="btn" type="button" data-open-ai>✦ Ask Vishakha AI <span>→</span></button><a class="btn btn-ghost" href="{% url 'portal:section' 'apps' %}">Explore all apps ↗</a></div></div><img src="{% static 'assets/vishakha-ai.png' %}" alt="Vishakha AI assistant mascot"></section><section class="section vone-continue-section" id="vone-continue-section" hidden aria-labelledby="vone-continue-heading"><div class="section-header"><div><span class="eyebrow">PICK UP WHERE YOU LEFT OFF</span><h2 id="vone-continue-heading">Recently visited sections</h2><p>Quickly return to areas you opened on this device.</p></div><button type="button" class="vone-continue-clear" id="vone-continue-clear">Clear history</button></div><nav class="vone-continue-grid" id="vone-continue-grid" aria-label="Recently visited portal sections"></nav></section><section class="section apps-section"><div class="section-header"><div><span class="eyebrow">YOUR WORKSPACE</span><h2>Quick access to applications</h2><p>All your essential work tools, just one click away.</p></div><a class="text-link" href="{% url 'portal:section' 'apps' %}">View all apps →</a></div><div class="app-toolbar"><label class="filter-search"><span>⌕</span><input id="app-filter" placeholder="Find an application..." aria-label="Filter applications"></label><div class="app-toolbar-actions"><button type="button" class="favorites-filter" aria-pressed="false">☆ Favorites</button><span class="app-count">{{ apps|length }} applications</span></div></div><div class="grid app-grid" id="app-grid" data-home-app-grid="true">{% for app in apps %}<a class="app-card" data-name="{{ app.name|lower }}" data-category="{{ app.category|lower }}" href="{% if app.url %}{{ app.url }}{% else %}#{% endif %}" {% if app.url %}target="_blank" rel="noopener noreferrer"{% else %}data-unconfigured="true"{% endif %}><span class="app-icon-wrap">{% if app.icon_path %}<img src="{% static app.icon_path %}" alt="" loading="lazy">{% else %}<span class="app-initial">{{ app.name|slice:':1' }}</span>{% endif %}</span><span class="app-meta"><strong>{{ app.name }}</strong><small>{{ app.category|default:'Company application' }}</small></span><button type="button" class="favorite-toggle" data-favorite="{{ app.name }}" aria-label="Favorite {{ app.name }}" aria-pressed="false">☆</button><span class="app-arrow" aria-hidden="true">↗</span></a>{% endfor %}</div><div class="vone-app-more-wrap"><button type="button" id="vone-app-load-more" class="vone-app-more">Load more applications ↓</button><a href="{% url 'portal:section' 'apps' %}">View full directory ↗</a></div><p id="apps-empty" class="empty-message" hidden>No applications match your search.</p></section><div class="home-highlights"><a class="highlight-tile vone-highlight-link" href="{% url 'portal:section' 'news' %}" aria-label="Company news: updates and announcements"><span class="highlight-icon" aria-hidden="true">▤</span><div><strong>Company news</strong><small>Updates & announcements</small></div><span class="vone-highlight-arrow" aria-hidden="true">→</span></a><a class="highlight-tile vone-highlight-link" href="{% url 'portal:section' 'policies' %}" aria-label="Policies and documents: important employee resources"><span class="highlight-icon" aria-hidden="true">▧</span><div><strong>Policies & documents</strong><small>Important employee resources</small></div><span class="vone-highlight-arrow" aria-hidden="true">→</span></a><a class="highlight-tile vone-highlight-link" href="{% url 'portal:section' 'joiners' %}" aria-label="Our people: new joiners and recognition"><span class="highlight-icon" aria-hidden="true">♧</span><div><strong>Our people</strong><small>New joiners & recognition</small></div><span class="vone-highlight-arrow" aria-hidden="true">→</span></a></div><div class="content-grid"><section class="section news-section"><div class="section-header"><div><span class="eyebrow">STAY INFORMED</span><h2>Latest updates</h2></div><a class="text-link" href="{% url 'portal:section' 'news' %}">See all →</a></div>{% for item in announcements %}<div class="news-row"><span class="news-icon">✧</span><div><strong>{{ item.title }}</strong><p>{{ item.summary|truncatechars:150 }}</p><small>{{ item.get_category_display }} · {{ item.published_at|date:"d M Y" }}</small></div></div>{% empty %}<p class="content-empty">No company announcements published yet.</p>{% endfor %}</section><section class="section resources-section"><div class="section-header"><div><span class="eyebrow">HELPFUL LINKS</span><h2>Employee resources</h2></div></div><a class="resource-link" href="{% url 'portal:section' 'policies' %}"><span class="resource-icon">▤</span><span><strong>Policies & guidelines</strong><small>Company policies in one place</small></span><b>→</b></a><a class="resource-link" href="{% url 'portal:section' 'joiners' %}"><span class="resource-icon">♧</span><span><strong>New joiners</strong><small>Welcome new colleagues</small></span><b>→</b></a><a class="resource-link" href="{% url 'portal:section' 'careers' %}"><span class="resource-icon">▥</span><span><strong>Internal careers</strong><small>Explore opportunities</small></span><b>→</b></a></section></div><section class="section step9-policies"><div class="section-header"><div><span class="eyebrow">LATEST COMPANY RESOURCES</span><h2>Recently published policies</h2><p>Official policies and guidelines shared by your administration team.</p></div><a class="text-link" href="{% url 'portal:section' 'policies' %}">All policies →</a></div><div class="step9-policy-grid">{% for policy in featured_policies %}{% if policy.access_url %}<a class="step9-policy-card vone-resource-launch vone-policy-click-card" href="{{ policy.access_url }}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ policy.title }}"><span class="step9-policy-icon" aria-hidden="true">▤</span><div><strong>{{ policy.title }}</strong><p>{{ policy.summary|truncatechars:115 }}</p><small>{{ policy.department|default:'Company-wide' }} · {{ policy.published_at|date:'d M Y' }}</small></div><span class="vone-policy-open" aria-hidden="true">Open ↗</span></a>{% else %}<article class="step9-policy-card"><span class="step9-policy-icon" aria-hidden="true">▤</span><div><strong>{{ policy.title }}</strong><p>{{ policy.summary|truncatechars:115 }}</p><small>{{ policy.department|default:'Company-wide' }} · {{ policy.published_at|date:'d M Y' }}</small></div></article>{% endif %}{% empty %}<p class="content-empty">No policies have been published yet.</p>{% endfor %}</div></section><div class="content-grid step7-grid"><section class="section"><div class="section-header"><div><span class="eyebrow">OUR PEOPLE</span><h2>Welcome new colleagues</h2></div><a class="text-link" href="{% url 'portal:section' 'joiners' %}">See all →</a></div><div class="vone-joiner-grid">{% for person in new_joiners %}
<article class="vone-joiner-card">
{% if person.introduction_document %}<a class="vone-joiner-open" href="{{ person.introduction_document.url }}" aria-label="Open introduction for {{ person.employee_name }}" title="View full introduction">
{% else %}<div class="vone-joiner-open" aria-label="{{ person.employee_name }}">{% endif %}
<div class="vone-joiner-portrait">{% if person.photo %}<img src="{{ person.photo.url }}" alt="Portrait of {{ person.employee_name }}" loading="lazy">{% else %}<span aria-hidden="true">{{ person.employee_name|slice:":1" }}</span>{% endif %}</div>
<div class="vone-joiner-details"><strong>{{ person.employee_name }}</strong><small>{{ person.designation }}</small><small>{{ person.department }}</small></div>
{% if person.introduction_document %}<span class="vone-joiner-read">View introduction <span aria-hidden="true">↗</span></span>{% endif %}
{% if person.introduction_document %}</a>{% else %}</div>{% endif %}
</article>{% empty %}<p class="content-empty">New joiner introductions will appear here.</p>{% endfor %}</div></section><section class="section"><div class="section-header"><div><span class="eyebrow">WHAT'S NEXT</span><h2>Upcoming events</h2></div><a class="text-link" href="{% url 'portal:section' 'news' %}">See all →</a></div>{% for event in upcoming_events %}<div class="news-row"><span class="news-icon">▣</span><div><strong>{{ event.title }}</strong><p>{{ event.starts_at|date:"d M Y, g:i A" }} · {{ event.location }}</p></div></div>{% empty %}<p class="content-empty">No upcoming events have been published.</p>{% endfor %}</section></div>
<section class="section vone-home-gallery" id="vone-life-at-vishakha" aria-labelledby="vone-gallery-heading">
 <div class="section-header"><div><span class="eyebrow">OUR CULTURE</span><h2 id="vone-gallery-heading">Life at Vishakha</h2><p>Moments from across our workplace.</p></div></div>
 <div class="vone-photo-grid">{% for item in gallery_photos %}<button class="vone-photo" type="button" data-preview-image="{{ item.image.url }}" data-preview-title="{{ item.title }}" aria-label="Preview {{ item.title }} photograph"><img src="{{ item.image.url }}" alt="{{ item.title }}" loading="lazy"><span>{{ item.title }}</span></button>{% empty %}<div class="vone-empty">Company photographs will appear here when approved news and event images are published.</div>{% endfor %}</div>
</section>
<section class="section vone-home-recognition" aria-labelledby="vone-recognition-heading">
 <div class="section-header"><div><span class="eyebrow">CELEBRATING OUR PEOPLE</span><h2 id="vone-recognition-heading">Rewards & Recognition</h2><p>Recognizing colleagues who make a difference.</p></div><a class="text-link" href="{% url 'portal:section' 'news' %}?category=recognition">See all →</a></div>
 <div class="vone-recognition-rail">{% for award in recognitions %}
 <article class="vone-recognition-card">{% if award.image %}<a href="{{ award.image.url }}" target="_blank" rel="noopener noreferrer"><img src="{{ award.image.url }}" alt="{{ award.title }}" loading="lazy"></a>{% endif %}
 <div><span class="eyebrow">RECOGNITION</span><h3>{{ award.title }}</h3><p>{{ award.summary|truncatechars:200 }}</p><small>{{ award.published_at|date:"d M Y" }}</small></div></article>
 {% empty %}<p class="vone-empty">Approved employee recognition stories will appear here.</p>{% endfor %}</div>
</section>
<section class="section vone-home-csr" aria-labelledby="vone-csr-heading">
 <div class="section-header"><div><h2 id="vone-csr-heading">Corporate Social Responsibility</h2></div></div>
 <div class="vone-csr-banner" {% if csr_cover %}style="--vone-csr-cover:url('{{ csr_cover.cover_image.url }}')"{% endif %}>
  <div class="vone-csr-overlay"><h3>Giving Back Together</h3><p>Creating meaningful impact through care,<br> opportunity and community action.</p>
  <a href="https://vishakhafoundation.org/" target="_blank" rel="noopener noreferrer">Visit Foundation Website</a></div>
 </div>
</section>
<section class="section vone-home-insider" aria-labelledby="vone-insider-heading">
 <div class="section-header"><div><span class="eyebrow">COMPANY PUBLICATIONS</span><h2 id="vone-insider-heading">Vishakha Insider</h2><p>Explore recent editions of our employee magazine.</p></div>
 <div class="vone-rail-controls"><button type="button" data-rail-prev="insiders" aria-label="Scroll Insider editions left">‹</button><button type="button" data-rail-next="insiders" aria-label="Scroll Insider editions right">›</button></div></div>
 <div class="vone-preview-rail vone-insider-rail" data-preview-rail="insiders">
 {% for issue in homepage_insiders %}
 <article class="vone-preview-card">
 <a class="vone-preview-cover vone-resource-launch" href="{% if issue.access_url %}{{ issue.access_url }}{% elif issue.cover_image %}{{ issue.cover_image.url }}{% else %}#{% endif %}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ issue.title }}">
 {% if issue.cover_image %}<img src="{{ issue.cover_image.url }}" alt="{{ issue.title }} cover" loading="lazy">{% else %}<div class="vone-preview-fallback"><span>VISHAKHA INSIDER</span><strong>{{ issue.title }}</strong><small>Employee magazine</small></div>{% endif %}
 </a><div class="vone-preview-card-copy"><h3><a class="vone-resource-title-link" href="{% if issue.access_url %}{{ issue.access_url }}{% elif issue.cover_image %}{{ issue.cover_image.url }}{% else %}#{% endif %}" target="_blank" rel="noopener noreferrer">{{ issue.title }}</a></h3><p>{{ issue.summary|truncatechars:95 }}</p>{% if issue.access_url %}<a href="{{ issue.access_url }}" target="_blank" rel="noopener noreferrer">Open original ↗</a>{% endif %}</div>
 </article>{% empty %}<div class="vone-empty">Publish Vishakha Insider issues in Content Manager to show them here.</div>{% endfor %}
 </div>
</section>
<section class="section vone-home-benefits" aria-labelledby="vone-benefits-heading">
 <div class="section-header"><div><span class="eyebrow">EMPLOYEE SERVICES</span><h2 id="vone-benefits-heading">Bank Benefits</h2><p>Browse approved employee banking offers.</p></div>
 <div class="vone-rail-controls"><button type="button" data-rail-prev="banks" aria-label="Scroll bank benefits left">‹</button><button type="button" data-rail-next="banks" aria-label="Scroll bank benefits right">›</button></div></div>
 <div class="vone-preview-rail vone-bank-rail" data-preview-rail="banks">
 {% for benefit in homepage_bank_benefits %}
 <article class="vone-preview-card">
 <a class="vone-preview-cover vone-resource-launch" href="{% if benefit.access_url %}{{ benefit.access_url }}{% elif benefit.cover_image %}{{ benefit.cover_image.url }}{% else %}#{% endif %}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ benefit.title }}">
 {% if benefit.cover_image %}<img src="{{ benefit.cover_image.url }}" alt="{{ benefit.title }} benefit poster" loading="lazy">{% else %}<div class="vone-preview-fallback"><span>BANK BENEFITS</span><strong>{{ benefit.title }}</strong><small>Employee banking</small></div>{% endif %}</a>
 <div class="vone-preview-card-copy"><h3><a class="vone-resource-title-link" href="{% if benefit.access_url %}{{ benefit.access_url }}{% elif benefit.cover_image %}{{ benefit.cover_image.url }}{% else %}#{% endif %}" target="_blank" rel="noopener noreferrer">{{ benefit.title }}</a></h3><p>{{ benefit.summary|truncatechars:85 }}</p>{% if benefit.access_url %}<a href="{{ benefit.access_url }}" target="_blank" rel="noopener noreferrer">Open ↗</a>{% endif %}</div></article>
 {% empty %}<div class="vone-empty">Approved bank benefit posters and documents will appear here.</div>{% endfor %}
 </div>
</section>
<section class="section vone-home-canteen" aria-labelledby="vone-canteen-heading">
 <div class="section-header"><div><span class="eyebrow">DAILY WORKPLACE</span><h2 id="vone-canteen-heading">What's Cooking?</h2><p>Lunch and evening snacks for this week.</p></div><a class="vone-canteen-full-link" href="{% url 'portal:canteen_menu' %}">Full weekly menu →</a></div>
 <div class="vone-menu-day-tabs" role="tablist" aria-label="Select canteen menu day">{% for day in homepage_canteen_days %}<button type="button" class="vone-menu-day-tab" role="tab" id="vone-home-tab-{{ forloop.counter }}" aria-controls="vone-home-panel-{{ forloop.counter }}" aria-selected="{% if day.is_today %}true{% else %}false{% endif %}" data-vone-day-tab="{{ forloop.counter }}"><span>{{ day.date|date:'D' }}</span><strong>{{ day.date|date:'d' }}</strong>{% if day.menu.is_holiday %}<small>Closed</small>{% elif day.is_today %}<small>Today</small>{% else %}<small>{{ day.date|date:'M' }}</small>{% endif %}</button>{% endfor %}</div>
 <div class="vone-menu-panels">{% for day in homepage_canteen_days %}<article class="vone-menu-panel" id="vone-home-panel-{{ forloop.counter }}" role="tabpanel" aria-labelledby="vone-home-tab-{{ forloop.counter }}" {% if not day.is_today and not forloop.first %}hidden{% endif %}><div class="vone-menu-panel-head"><div><span class="vone-menu-eyebrow">LUNCH & EVENING SNACKS</span><h3>{{ day.date|date:'l, d F' }}</h3></div><span class="vone-menu-day-state">{% if day.menu.is_holiday %}Canteen closed{% elif day.is_today %}Today's menu{% else %}Daily menu{% endif %}</span></div>{% if day.menu.is_holiday %}<div class="vone-menu-empty">🔒 Holiday — Canteen closed</div>{% elif day.menu %}<div class="vone-menu-food-grid"><div><span>🥘 Veg / Dal</span><strong>{{ day.menu.lunch_veg_dal|default:'Not scheduled' }}</strong></div><div><span>🫓 Roti</span><strong>{{ day.menu.lunch_roti|default:'Not scheduled' }}</strong></div><div><span>🍚 Salad / Rice</span><strong>{{ day.menu.lunch_rice|default:'Not scheduled' }}</strong></div><div><span>🥛 Curd / Sweet</span><strong>{{ day.menu.lunch_curd|default:'Not scheduled' }}</strong></div></div><div class="vone-menu-snacks {% if day.menu.snacks %}is-special{% else %}is-regular{% endif %}">{% if day.menu.snacks %}<span class="vone-snack-icon" aria-hidden="true">✦</span><span class="vone-snack-copy"><small>CHEF'S SPECIAL</small><strong>{{ day.menu.snacks }}</strong></span>{% else %}<span class="vone-snack-icon" aria-hidden="true">☕</span><strong>Regular Snacks</strong>{% endif %}</div>{% else %}<div class="vone-menu-empty">Menu not updated yet</div>{% endif %}</article>{% endfor %}</div>
</section>
<section class="section vone-home-videos" aria-labelledby="vone-videos-heading">
 <div class="section-header"><div><span class="eyebrow">WATCH & LEARN</span><h2 id="vone-videos-heading">Company Videos</h2><p>Policy videos, workplace learning and company stories.</p></div>
 <div class="vone-rail-controls"><button type="button" data-rail-prev="videos" aria-label="Scroll videos left">‹</button><button type="button" data-rail-next="videos" aria-label="Scroll videos right">›</button></div></div>
 <div class="vone-preview-rail vone-video-rail" data-preview-rail="videos">
 {% for video in homepage_videos %}<article class="vone-preview-card">
 {% if video.file %}
 <video controls preload="none" playsinline {% if video.cover_image %}poster="{{ video.cover_image.url }}"{% endif %} aria-label="{{ video.title }}">
 <source src="{{ video.file.url }}" type="{% if video.file.name|lower|slice:'-5:' == '.webm' %}video/webm{% else %}video/mp4{% endif %}">
 Your browser does not support HTML5 video. <a href="{{ video.file.url }}">Open video</a>
 </video>
 {% elif video.cover_image %}<a class="vone-preview-cover vone-resource-launch" href="{{ video.access_url }}" target="_blank" rel="noopener noreferrer" aria-label="Open video {{ video.title }}"><img src="{{ video.cover_image.url }}" alt="{{ video.title }}" loading="lazy"><span class="vone-video-play-indicator" aria-hidden="true">▶</span></a>{% else %}<div class="vone-preview-cover"><div class="vone-preview-fallback"><span>VISHAKHA VIDEO</span><strong>{{ video.title }}</strong></div></div>{% endif %}
 <div class="vone-preview-card-copy"><h3>{% if video.access_url %}<a class="vone-resource-title-link" href="{{ video.access_url }}" target="_blank" rel="noopener noreferrer">{{ video.title }}</a>{% else %}{{ video.title }}{% endif %}</h3><p>{{ video.summary|truncatechars:95 }}</p>
 {% if video.access_url %}<a href="{{ video.access_url }}" target="_blank" rel="noopener noreferrer">Open video ↗</a>{% endif %}</div>
 </article>{% empty %}<div class="vone-empty">Approved company videos will appear here when published.</div>{% endfor %}
 </div>
</section>
<section class="section vone-home-brochures" aria-labelledby="vone-brochures-heading">
 <div class="section-header"><div><span class="eyebrow">COMPANY RESOURCES</span><h2 id="vone-brochures-heading">Brochures</h2><p>Approved company and business brochures.</p></div><a class="text-link" href="{% url 'portal:section' 'documents' %}">Documents →</a></div>
 <div class="vone-brochure-grid">{% for brochure in homepage_brochures %}<article class="vone-brochure"><span class="vone-brochure-icon" aria-hidden="true">▤</span><div><strong>{% if brochure.access_url %}<a class="vone-resource-title-link" href="{{ brochure.access_url }}" target="_blank" rel="noopener noreferrer">{{ brochure.title }}</a>{% else %}{{ brochure.title }}{% endif %}</strong><small>{{ brochure.summary|truncatechars:100 }}</small></div>{% if brochure.access_url %}<a href="{{ brochure.access_url }}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ brochure.title }}">Open ↗</a>{% endif %}</article>{% empty %}<p class="vone-empty">No brochures have been published yet.</p>{% endfor %}</div>
</section>
{% endblock %}
