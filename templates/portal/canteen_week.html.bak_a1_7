{% extends 'base.html' %}{% load static %}{% block content %}<main class="vone-canteen-wrap vone-canteen-modern"><div class="vone-canteen-head"><div><span class="eyebrow">DAILY WORKPLACE</span><h1>What's Cooking?</h1><p>Lunch and evening snacks · {{ monday|date:'d M Y' }} – {{ days.5.date|date:'d M Y' }}</p></div><nav class="vone-canteen-nav" aria-label="Choose week"><a href="?week={{ previous|date:'Y-m-d' }}">← Previous week</a><a href="{% url 'portal:canteen_menu' %}">Current week</a></nav></div><div class="vone-menu-day-tabs" role="tablist" aria-label="Select day">{% for day in days %}<button type="button" class="vone-menu-day-tab" role="tab" id="vone-full-tab-{{ forloop.counter }}" aria-controls="vone-full-panel-{{ forloop.counter }}" aria-selected="{% if day.is_today %}true{% else %}false{% endif %}" data-vone-day-tab="{{ forloop.counter }}"><span>{{ day.date|date:'D' }}</span><strong>{{ day.date|date:'d' }}</strong><small>{% if day.menu.is_holiday %}Closed{% elif day.is_today %}Today{% else %}{{ day.date|date:'M' }}{% endif %}</small></button>{% endfor %}</div><div class="vone-menu-panels">{% for day in days %}<article class="vone-menu-panel" id="vone-full-panel-{{ forloop.counter }}" role="tabpanel" aria-labelledby="vone-full-tab-{{ forloop.counter }}" {% if not day.is_today and not forloop.first %}hidden{% endif %}><div class="vone-menu-panel-head"><div><span class="vone-menu-eyebrow">LUNCH & EVENING SNACKS</span><h2>{{ day.date|date:'l, d F' }}</h2></div><span class="vone-menu-day-state">{% if day.menu.is_holiday %}Canteen closed{% elif day.is_today %}Today's menu{% else %}Daily menu{% endif %}</span></div>{% if day.menu.is_holiday %}<div class="vone-menu-empty">🔒 Holiday — Canteen closed</div>{% elif day.menu %}<div class="vone-menu-food-grid"><div><span>🥘 Veg / Dal</span><strong>{{ day.menu.lunch_veg_dal|default:'Not scheduled' }}</strong></div><div><span>🫓 Roti</span><strong>{{ day.menu.lunch_roti|default:'Not scheduled' }}</strong></div><div><span>🍚 Salad / Papad / Rice</span><strong>{{ day.menu.lunch_rice|default:'Not scheduled' }}</strong></div><div><span>🥛 Curd / Sweet</span><strong>{{ day.menu.lunch_curd|default:'Not scheduled' }}</strong></div></div><div class="vone-menu-snacks">🍽 <span>Evening snacks</span><strong>{{ day.menu.snacks|default:'Not scheduled' }}</strong></div>{% else %}<div class="vone-menu-empty">Menu not updated yet</div>{% endif %}</article>{% endfor %}</div></main>{% endblock %}