# Template only: replace values and store securely OUTSIDE the repository.
# IMPORTANT: VONE_ENV is set by systemd. config/settings.py loads .env.staging
# if present; environment variables from this file take precedence.
DJANGO_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
DJANGO_ALLOWED_HOSTS=vone-staging.internal.example
DJANGO_CSRF_TRUSTED_ORIGINS=http://vone-staging.internal.example
PGDATABASE=vone_staging
PGUSER=vone_staging_user
PGPASSWORD=REPLACE_WITH_SECRET
PGHOST=127.0.0.1
PGPORT=5432
VONE_STATIC_ROOT=/srv/vishakha-one/staticfiles
VONE_MEDIA_ROOT=/srv/vishakha-one/media
VONE_HTTPS_READY=false
VONE_TRUST_PROXY_HTTPS=false
VONE_HSTS_SECONDS=0
VONE_SESSION_COOKIE_NAME=vone_staging_session
VONE_CSRF_COOKIE_NAME=vone_staging_csrf
