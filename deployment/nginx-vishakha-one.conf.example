# IT: change server_name to the allocated internal DNS hostname.
# Deploy TLS certificates before enabling HTTPS redirects/HSTS.
server {
    listen 80;
    server_name vone-staging.internal.example;
    client_max_body_size 25m;

    location /static/ {
        alias /srv/vishakha-one/staticfiles/;
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
    }
    # Uploaded media may contain sensitive company data. Public serving is NOT
    # enabled here; define authenticated access policy before exposing /media/.
    location /media/ { return 403; }

    location / {
        proxy_pass http://127.0.0.1:8101;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 65s;
    }
}
